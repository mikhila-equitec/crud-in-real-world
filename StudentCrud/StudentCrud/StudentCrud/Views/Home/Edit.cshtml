    <br />
    <div>
        @Html.ActionLink("Back to List", "/", null, new { @class = "btn -secondary", style = "margin-left:36%" })
    </div>

    <div id="updateStatus"></div>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>
    <script>

    $(document).ready(function () {
        $('#updateBtn').click(function () {
            var studentData = {
                Name: $('#Name').val(),
                RollNo: $('#RollNo').val(),
                DeptId: $('#DeptId').val(),
                Dept: $('#Dept').val(),
                DOB: $('#DOB').val(),
                Gender: $('#Gender').val(),
                Address: $('#SAddress').val(),
                PhoneNum: $('#PhoneNum').val(),
                Status: $('#status').val()
            };

            $.ajax({
                url: '@Url.Action("Edit", "Home")',
                type: 'POST',
                data: JSON.stringify(studentData),
                contentType: 'application/json; charset=utf-8',

                success: function (response) {
                    if (response.success) {
                        $('#updateStatus').html('<div class="alert alert-success">' + response.message + '</div>');
                        window.location.href = '@Url.Action("StudentShow", "Home")';

                    } else {
                        $('#updateStatus').html('<div class="alert alert-danger">' + response.message + '</div>');
                    }
                },
                error: function (xhr) {
                    $('#updateStatus').html('<div class="alert alert-danger">Error: ' + xhr.responseText + '</div>');
                }
            });
        });
    });
    </script>
</div>